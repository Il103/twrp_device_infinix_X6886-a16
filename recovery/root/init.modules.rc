# init.modules.rc - Infinix Hot 60 Pro Plus (x6886)
# Loads vendor kernel modules at recovery boot (display, touch, USB, TEE, Transsion)

on early-boot
    exec u:r:recovery:s0 root root -- /system/bin/sh -c "while read m; do insmod /lib/modules/$m 2>/dev/null; done < /lib/modules/modules.load.recovery"
    exec u:r:recovery:s0 root root -- /system/bin/sh -c "for k in /lib/modules/*.ko; do insmod \$k 2>/dev/null; done"
