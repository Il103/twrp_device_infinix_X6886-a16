# init.modules.rc - Infinix Hot 60 Pro Plus (x6886)
# Loads the vendor kernel modules (display / touch / usb / charger /
# trustonic TEE / transsion) at recovery boot so the screen, touch and
# decryption all come up. Order is taken from modules.load.recovery.

on early-boot
    # insmod every module listed for recovery
    exec u:r:recovery:s0 root root -- /system/bin/sh -c "while read m; do insmod /lib/modules/$m 2>/dev/null; done < /lib/modules/modules.load.recovery"
    # additionally pull in any module not in the recovery list (display/touch)
    exec u:r:recovery:s0 root root -- /system/bin/sh -c "for k in /lib/modules/*.ko; do insmod \$k 2>/dev/null; done"
